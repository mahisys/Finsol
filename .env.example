# --- Required -------------------------------------------------------------
# Long random string used to sign logins. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me
# Random string protecting the admin "Preview" links
PREVIEW_SECRET=change-me-too
# Public address of the website (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Database & uploads ---------------------------------------------------
DATABASE_URL=file:./finsol.db
# MEDIA_DIR=./media                      # public images (defaults to ./media)
# PRIVATE_UPLOADS_DIR=./private-uploads  # customer KYC documents (never public)

# --- Email (optional) -----------------------------------------------------
# Needed for new-lead alerts and password-reset emails. Without it emails are only logged.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@yourdomain.com
# SMTP_FROM_NAME=Finsol Website

# --- Seed script (optional) -----------------------------------------------
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=a-strong-password
# SEED_ON_START=true   # fill an EMPTY database with sample content on start-up
